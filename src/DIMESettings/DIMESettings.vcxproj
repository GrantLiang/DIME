<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>16.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{9f5017ed-34b2-4b01-8d92-ef3d8bfc427a}</ProjectGuid>
    <RootNamespace>DIMESettings</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
    <ProjectName>DIMESettings</ProjectName>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|Win32'" Label="Configuration">
    <ConfigurationType>Utility</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="Shared">
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|Win32'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <ItemDefinitionGroup>
    <PreBuildEvent>
      <Command>cd /d "$(ProjectDir).." &amp;&amp; call .\BuildInfo.cmd</Command>
    </PreBuildEvent>
  </ItemDefinitionGroup>
  <!--
    DIMESettings.exe is built by cargo (phase 5b-15f; the all-C++ executable was removed in
    phase 6a-4): rust/crates/dime-settings-exe, all Rust. This is a Utility project: the
    PreBuildEvent regenerates BuildInfo.h (the executable's version and caption), cargo builds
    the executable, and it is copied to $(OutDir) (src\Release\DIMESettings.exe for Release,
    where CI and the installer take it). Release uses the static CRT (+crt-static, like /MT);
    Debug uses the dynamic CRT. It needs a Rust toolchain with the i686-pc-windows-msvc target
    whatever DimeUseRustEngine is (that switch is about DIME.dll).
  -->
  <PropertyGroup Label="DimeRust">
    <DimeRustRoot>$(ProjectDir)..\..\rust\</DimeRustRoot>
    <DimeRustTarget>i686-pc-windows-msvc</DimeRustTarget>
    <DimeRustTargetDir Condition="'$(Configuration)'=='Release'">$(DimeRustRoot)target\crt-static\</DimeRustTargetDir>
    <DimeRustTargetDir Condition="'$(Configuration)'!='Release'">$(DimeRustRoot)target\</DimeRustTargetDir>
    <DimeRustFlags Condition="'$(Configuration)'=='Release'">-C target-feature=+crt-static</DimeRustFlags>
    <DimeRustOutDir>$(DimeRustTargetDir)$(DimeRustTarget)\release\</DimeRustOutDir>
    <DimeCargo Condition="Exists('$(USERPROFILE)\.cargo\bin\cargo.exe')">"$(USERPROFILE)\.cargo\bin\cargo.exe"</DimeCargo>
    <DimeCargo Condition="'$(DimeCargo)'==''">cargo</DimeCargo>
    <!-- The build script of dime-settings-exe is built for the x64 host. rustc (cc-rs) takes
         VSTEL_MSBuildProjectFullPath or VCINSTALLDIR as a developer prompt and would link it with
         this platform's link.exe and LIB (x86 for Win32); without them it finds MSVC and the
         libraries for each target itself. -->
    <DimeCargoEnv>set VSTEL_MSBuildProjectFullPath=&amp;&amp; set VCINSTALLDIR=&amp;&amp; set VSINSTALLDIR=&amp;&amp; set LIB=&amp;&amp; set LIBPATH=&amp;&amp; </DimeCargoEnv>
  </PropertyGroup>
  <Target Name="BuildDimeSettingsExe" AfterTargets="Build">
    <Exec Command="$(DimeCargoEnv)$(DimeCargo) build --release --locked -p dime-settings-exe --target $(DimeRustTarget) --target-dir &quot;$(DimeRustTargetDir.TrimEnd('\'))&quot; --manifest-path &quot;$(DimeRustRoot)Cargo.toml&quot;" EnvironmentVariables="RUSTFLAGS=$(DimeRustFlags)" />
    <Copy SourceFiles="$(DimeRustOutDir)DIMESettings.exe;$(DimeRustOutDir)DIMESettings.pdb" DestinationFolder="$(OutDir)" />
    <Message Importance="high" Text="DIMESettings -&gt; $(OutDir)DIMESettings.exe (cargo, $(DimeRustTarget))" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
  <ImportGroup Label="ExtensionTargets">
  </ImportGroup>
</Project>
